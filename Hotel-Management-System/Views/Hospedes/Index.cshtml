
@model IEnumerable<Hotel_Management_System.Data.Entities.Hospede>



@{

    ViewData["Title"] = "Hóspedes";

}



<h1>Hóspedes</h1>



<p>

    <a asp-action="Create">Criar novo hóspede</a>

</p>



<table class="table">

    <thead>

        <tr>

            <th>

                @Html.DisplayNameFor(model => model.Nome)

            </th>

            <th>

                @Html.DisplayNameFor(model => model.Contacto)

            </th>

            <th>

                @Html.DisplayNameFor(model => model.Email)

            </th>

            <th>

                @Html.DisplayNameFor(model => model.DocumentoIdentificacao)

            </th>

            <th></th>

        </tr>

    </thead>



    <tbody>

    @foreach (var item in Model)

    {

        <tr>

            <td>

                @Html.DisplayFor(modelItem => item.Nome)

            </td>

            <td>

                @Html.DisplayFor(modelItem => item.Contacto)

            </td>

            <td>

                @Html.DisplayFor(modelItem => item.Email)

            </td>

            <td>

                @Html.DisplayFor(modelItem => item.DocumentoIdentificacao)

            </td>

            <td>

                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |

                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |

                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>

            </td>

        </tr>

    }

    </tbody>

</table>

