
@model Hotel_Management_System.Models.RegisterNewUserViewModel



@{

    ViewData["Title"] = "Criar conta";

}



<div class="row justify-content-center mt-5">

    <div class="col-md-7 col-lg-5">

        <h1 class="mb-4">Criar conta</h1>



        <form asp-action="Register" method="post">

            <div asp-validation-summary="ModelOnly"

                 class="text-danger mb-3"></div>



            <div class="mb-3">

                <label asp-for="FirstName" class="form-label"></label>

                <input asp-for="FirstName" class="form-control" />

                <span asp-validation-for="FirstName" class="text-danger"></span>

            </div>



            <div class="mb-3">

                <label asp-for="LastName" class="form-label"></label>

                <input asp-for="LastName" class="form-control" />

                <span asp-validation-for="LastName" class="text-danger"></span>

            </div>



            <div class="mb-3">

                <label asp-for="Username" class="form-label">Email</label>

                <input asp-for="Username" class="form-control" />

                <span asp-validation-for="Username" class="text-danger"></span>

            </div>



            <div class="mb-3">

                <label asp-for="Password" class="form-label"></label>

                <input asp-for="Password" class="form-control" />

                <span asp-validation-for="Password" class="text-danger"></span>

            </div>



            <div class="mb-3">

                <label asp-for="Confirm" class="form-label"></label>

                <input asp-for="Confirm" class="form-control" />

                <span asp-validation-for="Confirm" class="text-danger"></span>

            </div>



            <button type="submit" class="btn btn-primary w-100">

                Criar conta

            </button>

        </form>



        <p class="mt-3">

            Já tens conta? <a asp-action="Login">Iniciar sessão</a>

        </p>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

