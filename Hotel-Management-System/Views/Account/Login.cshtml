
@model Hotel_Management_System.Models.LoginViewModel



@{

    ViewData["Title"] = "Iniciar sessão";

}



<div class="row justify-content-center mt-5">

    <div class="col-md-6 col-lg-4">

        <h1 class="mb-4">Iniciar sessão</h1>



        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]"

              method="post">

            <div asp-validation-summary="ModelOnly"

                 class="text-danger mb-3"></div>



            <div class="mb-3">

                <label asp-for="Username" class="form-label"></label>

                <input asp-for="Username" class="form-control" />

                <span asp-validation-for="Username" class="text-danger"></span>

            </div>



            <div class="mb-3">

                <label asp-for="Password" class="form-label"></label>

                <input asp-for="Password" class="form-control" />

                <span asp-validation-for="Password" class="text-danger"></span>

            </div>



            <div class="form-check mb-3">

                <input asp-for="RememberMe" class="form-check-input" />

                <label asp-for="RememberMe" class="form-check-label"></label>

            </div>



            <button type="submit" class="btn btn-primary w-100">

                Entrar

            </button>

        </form>



        <p class="mt-3">

            Ainda não tens conta?

            <a asp-action="Register">Registar</a>

        </p>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

